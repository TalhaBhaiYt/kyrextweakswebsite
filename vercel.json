{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/server.js"
    },
    {
      "src": "/css/(.*)",
      "dest": "public/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "public/js/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "public/images/$1"
    },
    {
      "src": "/admin.html",
      "dest": "public/admin.html"
    },
    {
      "src": "/dashboard.html",
      "dest": "public/dashboard.html"
    },
    {
      "src": "/login.html",
      "dest": "public/login.html"
    },
    {
      "src": "/register.html",
      "dest": "public/register.html"
    },
    {
      "src": "/(.*)",
      "dest": "public/index.html"
    }
  ]
}
